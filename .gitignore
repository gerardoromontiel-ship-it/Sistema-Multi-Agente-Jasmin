# .gitignore for Sistema Multi-Agente Jasmin
# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/

# Ignore IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore OS files
.DS_Store
Thumbs.db
desktop.ini

# Ignore local environment files
.env
.env.local
.env.*.local

# Ignore log files
logs/
*.log

# Ignore temp files
tmp/
temp/
*.tmp

# Ignore package files
*.zip
*.tar.gz
*.tar.bz2

# Ignore node_modules if any
node_modules/

# Ignore test files
tests/
test/
